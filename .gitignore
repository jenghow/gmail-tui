# --- Rust / Cargo build output --------------------------------------------
/target
**/*.rs.bk

# `Cargo.lock` is deliberately NOT ignored: this is a binary crate, so the
# locked dependency versions are what a reproducible build depends on.

# --- Local secrets & runtime state ----------------------------------------
# Credentials live in the OS config/data directories (see README), so these
# entries only guard against a copy being run from, or written into, the tree.
.env
credentials.enc

# --- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
